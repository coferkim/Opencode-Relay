{
  "name": "opencode-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:api": "uv run uvicorn backend.app:app --host 127.0.0.1 --port 8949",
    "dev:web": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "start": "uv run uvicorn backend.app:app --host 127.0.0.1 --port 8949",
    "test:bridge": "bun test bridge tests/bridge",
    "check": "bunx tsc --noEmit && bun run --cwd frontend check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
