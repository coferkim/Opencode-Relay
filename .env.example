# Free models work without any configuration. This is the server-wide default.
# The web UI can override the upstream key per request (kept only in page memory).
OPENCODE_API_KEY=public
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
# Optional: override the model catalog endpoint when using another upstream.
# OPENCODE_MODELS_URL=https://opencode.ai/inference/v1/models
OPENCODE_CLIENT=desktop
OPENCODE_VERSION=2.2.5
OPENCODE_TIMEOUT_SECONDS=120
OPENCODE_MAX_CONCURRENT_REQUESTS=8
# Optional: require this Bearer token for /v1/* when exposing the gateway.
# RELAY_API_KEY=your-private-relay-token
# Override only if bun is not available on PATH.
# BUN_EXECUTABLE=C:\Users\you\.bun\bin\bun.exe
# Docker publishes only to localhost by default. Enable LAN/public access deliberately,
# with RELAY_API_KEY and an HTTPS reverse proxy in front of the service.
# BIND_ADDRESS=0.0.0.0
